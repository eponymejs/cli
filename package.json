{
  "name": "@eponyme/cli",
  "version": "0.1.0",
  "description": "Install and verify the Prisma schema required by Eponyme.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.12.0"
  },
  "bin": {
    "eponyme": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema.prisma": "./prisma/schema.prisma",
    "./migrations/*": "./prisma/migrations/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "unbuild",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:postgres": "node scripts/test-postgresql.mjs",
    "test:tarball": "node scripts/test-tarball.mjs",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "jiti": "^2.5.1"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/node": "latest",
    "pg": "^8.16.3",
    "prisma": "^7.9.1",
    "typescript": "~6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
